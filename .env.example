# NeonDB (PostgreSQL) connection string
# Formato: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Obtenlo gratis en https://neon.tech
DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel deployment:
# Configura DATABASE_URL en Settings > Environment Variables en tu proyecto de Vercel.
